{
  "manifest_version": 3,
  "name": "Service Desk 8x8 Assistant",
  "version": "1.0.0",
  "version_name": "1.0",
  "description": "Phone-cover reminders, break timers and Call Notes for the Service Desk.",
  "author": "Joshua Lavagna-Slater",
  "minimum_chrome_version": "120",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "notifications",
    "scripting"
  ],
  "host_permissions": [
    "https://vcc-au2.8x8.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Service Desk 8x8 Assistant",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://vcc-au2.8x8.com/*"
      ],
      "js": [
        "shared.js",
        "bootstrap.js",
        "assistant.js"
      ],
      "run_at": "document_idle",
      "all_frames": false,
      "world": "ISOLATED"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  }
}
